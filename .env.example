# Telegram - Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenAI - For ranking and summaries
OPENAI_API_KEY=your_openai_api_key

# Model per step. Defaults are gpt-6.1-sol for ranking — the harder call, and
# the one that decides the digest's quality — and gpt-6-luna for the summary.
# Both replace gpt-4o-mini, which OpenAI has scheduled for shutdown on
# 14-Jan-2027. Set these to override one step.
# OPENAI_MODEL_RANKING=
# OPENAI_MODEL_SUMMARY=
# Overrides both at once; the one-line rollback.
# OPENAI_MODEL=
# Only for a reasoning model, which otherwise uses its own default effort.
# OPENAI_REASONING_EFFORT=

# GitHub - For fetching repo releases (optional for local dev, auto-provided in GitHub Actions)
GITHUB_TOKEN=your_github_personal_access_token

# Vercel KV - holds the daily send claim, which is what stops two overlapping
# GitHub Actions runs sending the same digest twice. Optional locally, where
# nothing overlaps; set in Actions.
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token
