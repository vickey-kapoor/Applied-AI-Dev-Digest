# Telegram - Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenAI - For ranking and summaries
OPENAI_API_KEY=your_openai_api_key

# Model per step. Both default to gpt-4o-mini, which OpenAI has scheduled for
# shutdown on 14-Jan-2027; set these to try a replacement without a code
# change. Ranking is the harder job and the one that decides the digest's
# quality, so it is worth the stronger model; the summarizer extracts facts
# from one article the ranker already chose.
# OPENAI_MODEL_RANKING=
# OPENAI_MODEL_SUMMARY=
# Only for a reasoning model, which otherwise uses its own default effort.
# OPENAI_REASONING_EFFORT=

# GitHub - For fetching repo releases (optional for local dev, auto-provided in GitHub Actions)
GITHUB_TOKEN=your_github_personal_access_token

# Vercel KV - For dashboard features (optional for pipeline, required for dashboard)
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token

# Dashboard API auth (optional - if set, POST endpoints require Authorization: Bearer <secret>)
# When unset, same-origin browser requests are allowed (open mode for local dev)
DASHBOARD_API_SECRET=
